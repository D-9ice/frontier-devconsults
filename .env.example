# Public Supabase values are safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only values. Add these to Vercel; never prefix them with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
ADMIN_SESSION_SECRET=replace-with-a-long-random-secret

# Email delivery through Resend. Verify the sender domain in Resend before deployment.
RESEND_API_KEY=re_your-resend-api-key
EMAIL_FROM=Frontier DevConsults <info@frontier-devconsults.com>
EMAIL_TO=frontierdevconsults@gmail.com

# Monitoring credentials. Generate separate random values of at least 32 characters.
# CRON_SECRET authenticates the daily Vercel Cron fallback.
MONITORING_JOB_TOKEN=replace-with-a-long-random-job-token
MONITORING_READ_TOKEN=replace-with-a-separate-long-random-read-token
CRON_SECRET=replace-with-a-separate-long-random-cron-secret
RESEND_WEBHOOK_SECRET=whsec_your-resend-webhook-secret

# Meta WhatsApp Cloud API owner alerts. All values are server-only.
# The approved template must contain four body variables: subject, summary, timestamp, admin link.
WHATSAPP_GRAPH_API_VERSION=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_OWNER_PHONE_E164=
WHATSAPP_ALERT_TEMPLATE_NAME=
WHATSAPP_ALERT_TEMPLATE_LANGUAGE=
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# Development-only fallback for local admin login before Supabase is configured.
ADMIN_PASSWORD=replace-with-a-local-development-password

# Native Frontier Assistant (server-only API key; never use NEXT_PUBLIC_).
OPENAI_API_KEY=sk-your-project-key
OPENAI_MODEL=gpt-5.6-luna
OPENAI_REASONING_EFFORT=low
OPENAI_ASSISTANT_MAX_OUTPUT_TOKENS=500
OPENAI_ASSISTANT_RATE_LIMIT=12

# Optional Upwork-safe return link. Hidden unless this is a valid https://www.upwork.com URL.
UPWORK_PROFILE_URL=

# Optional search-engine ownership verification values (paste only the token value).
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

# Server-only IndexNow key: 8-128 letters, numbers, or hyphens. Never prefix with NEXT_PUBLIC_.
INDEXNOW_KEY=
